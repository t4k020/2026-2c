@model List<_2C_2026_CLASE3.Entidades.Animal>

@if(TempData["Mensaje"] != null)
{
    <div class="alert alert-success">
        @TempData["Mensaje"]
    </div>
}

<h1>Animales</h1>
@*Listado de animales con raza, peso, edad estimada y si esta en extinción.*@

<a asp-action="Agregar" class="btn btn-primary mb-3">Agregar</a>

<table class="table">
    <thead>
        <tr>
            <th></th>
            <th>Raza</th>
            <th>Peso</th>
            <th>Edad Estimada</th>
            <th>En Extinción</th>
            <th>Habitat</th>
            <th>Lugar de Origen</th>
            <th>Largo</th>
            <th>Alto</th>
            <th colspan="2">Acciones</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var animal in Model)
        {
        <tr>
            <td><partial name="_AnimalAvatar" model="animal" /></td>
            <td>@animal.Raza</td>
            <td>@animal.Peso</td>
            <td>@animal.EdadEstimada</td>
            <td>@(animal.EnExtincion ? "Si" : "No")</td>
            <td>@animal.Habitat</td>
            <td>@animal.LugarOrigen</td>
            <td>@animal.Largo</td>
            <td>@animal.Alto</td>
            <td><a asp-action="Editar" asp-route-id="@animal.Id">Editar</a></td>
            <td>
                <form asp-action="Eliminar" asp-route-id="@animal.Id" method="post" class="d-inline">
                    <button type="submit" class="btn btn-link p-0" onclick="return confirm('¿Eliminar @animal.Raza?')">Eliminar</button>
                </form>
            </td>
        </tr>
        }
    </tbody>
</table>
