@{
    Layout = "_LayoutFlores";
}

@model ClaseMVC.Entidades.Flor

<h1>Agregar Flor</h1>
<a href="/flores" class="btn btn-secondary mb-3">Volver</a>

<form action="@Url.Action("Agregar", "Flores")" method="post">
    <div class="form-group">
        <label for="nombre">Nombre</label>
        <input type="text" class="form-control" id="nombre" name="nombre" value="@Model.nombre" required />
    </div>
    <div class="form-group">
        <label for="descripcion">Descripción</label>
        <input type="text" class="form-control" id="descripcion" name="descripcion" value="@Model.descripcion" />
    </div>
    <div class="form-group">
        <label for="imgUrl">URL de la Imagen</label>
        <input type="text" class="form-control" id="imgUrl" name="imgUrl" value="@Model.imgUrl" />
    </div>
    <button type="submit" class="btn btn-primary">Agregar Flor</button>
</form>
