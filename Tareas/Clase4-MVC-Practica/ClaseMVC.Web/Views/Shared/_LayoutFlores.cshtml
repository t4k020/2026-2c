@* ============================================================
   _LayoutFlores.cshtml
   Tema: selva / diario de campo, versión para flora
   ============================================================ *@
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewBag.Title - Diario de Flora</title>

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,500;9..144,700&family=Space+Mono:wght@400;700&display=swap" rel="stylesheet">

    <style>
        :root{
            /* --- Paleta botánica: dosel, sotobosque, corteza, ficha de campo --- */
            --dosel-900:#0f2417;
            --dosel-700:#1c3a26;
            --sotobosque-500:#3d6b45;
            --musgo-300:#7fa06f;
            --hoja-400:#5c8a4a;
            --corteza-800:#4a3423;
            --corteza-950:#2b1e14;
            --tierra-100:#e9e2d0;
            --ambar-500:#b6822c;
            --brasa-600:#a34426;
            --hueso-050:#f4efe2;

            --font-display:'Fraunces', serif;
            --font-mono:'Space Mono', monospace;
        }

        *{ box-sizing:border-box; }

        html,body{
            margin:0;
            padding:0;
            background:var(--tierra-100);
            color:var(--dosel-900);
            font-family:var(--font-mono);
            line-height:1.5;
        }

        body{
            background-image:
                radial-gradient(circle at 15% 20%, rgba(61,107,69,0.05) 0, transparent 45%),
                radial-gradient(circle at 85% 80%, rgba(74,52,35,0.06) 0, transparent 50%);
        }

        a{ color:inherit; }

        /* ================= HEADER ================= */
        header.site-header{
            background:
                linear-gradient(180deg, var(--dosel-900) 0%, var(--dosel-700) 100%);
            border-bottom:6px solid var(--corteza-800);
            position:relative;
            overflow:hidden;
        }

        header.site-header .leaf-deco{
            position:absolute;
            top:0; left:0; right:0; bottom:0;
            opacity:.14;
            pointer-events:none;
        }

        header.site-header::after{
            content:"";
            display:block;
            height:14px;
            background-image:
                radial-gradient(circle, var(--hoja-400) 2.5px, transparent 3px);
            background-size:22px 14px;
            background-position:0 3px;
            opacity:.55;
        }

        .header-inner{
            max-width:1100px;
            margin:0 auto;
            padding:1.9rem 1.5rem 1.4rem;
            display:flex;
            align-items:baseline;
            justify-content:space-between;
            flex-wrap:wrap;
            gap:.5rem;
            position:relative;
        }

        .brand{
            font-family:var(--font-display);
            font-weight:700;
            font-size:2.15rem;
            color:var(--hueso-050);
            letter-spacing:.5px;
            text-decoration:none;
            display:inline-flex;
            align-items:center;
            gap:.5rem;
        }

        .brand svg{ width:1.6rem; height:1.6rem; flex-shrink:0; }

        .brand span{
            color:var(--musgo-300);
            font-style:italic;
            font-weight:500;
        }

        nav.site-nav ul{
            list-style:none;
            display:flex;
            gap:1.5rem;
            margin:0;
            padding:0;
        }

        nav.site-nav a{
            text-decoration:none;
            color:var(--hueso-050);
            font-size:.85rem;
            border-bottom:2px solid transparent;
            padding-bottom:2px;
            transition:border-color .15s ease;
        }

        nav.site-nav a:hover{
            border-color:var(--ambar-500);
        }

        /* ================= MAIN ================= */
        main.site-main{
            max-width:1100px;
            margin:0 auto;
            padding:2.5rem 1.5rem 4rem;
        }

        .page-title{
            font-family:var(--font-display);
            font-size:2rem;
            font-weight:700;
            color:var(--dosel-700);
            margin:0 0 .35rem;
        }

        .page-subtitle{
            color:var(--corteza-800);
            font-size:.9rem;
            margin:0 0 2rem;
            max-width:60ch;
        }

        /* ---------- Utilidades para el listado de flores ---------- */
        .flor-grid{
            display:grid;
            grid-template-columns:repeat(auto-fill, minmax(230px, 1fr));
            gap:1.25rem;
        }

        .flor-card{
            background:var(--hueso-050);
            border:1px solid rgba(74,52,35,0.15);
            border-left:4px solid var(--sotobosque-500);
            border-radius:2px;
            padding:1.1rem 1.1rem 1.3rem;
            position:relative;
        }

        .flor-card h3{
            font-family:var(--font-display);
            font-size:1.15rem;
            margin:.2rem 0 .1rem;
            color:var(--dosel-900);
        }

        .flor-card .nombre-cientifico{
            font-style:italic;
            font-size:.78rem;
            color:var(--sotobosque-500);
            margin:0 0 .6rem;
        }

        .estado-conservacion{
            display:inline-block;
            font-size:.7rem;
            padding:.2rem .55rem;
            border-radius:2px;
            font-weight:700;
        }

        .estado-conservacion.estable{
            background:rgba(61,107,69,0.15);
            color:var(--sotobosque-500);
        }

        .estado-conservacion.vulnerable{
            background:rgba(182,130,44,0.18);
            color:var(--ambar-500);
        }

        .estado-conservacion.peligro{
            background:rgba(163,68,38,0.18);
            color:var(--brasa-600);
        }

        /* ================= FOOTER ================= */
        footer.site-footer{
            background:var(--corteza-950);
            color:var(--hueso-050);
            padding:2rem 1.5rem 1.5rem;
            font-size:.78rem;
            position:relative;
            overflow:hidden;
        }

        footer.site-footer::before{
            content:"";
            display:block;
            height:12px;
        }
    </style>
</head>
<body>
    <header class="site-header">
        <svg class="leaf-deco" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 800 200" preserveAspectRatio="none">
            <defs>
                <linearGradient id="g1" x1="0" x2="1">
                    <stop offset="0" stop-color="#7fa06f" stop-opacity=".12" />
                    <stop offset="1" stop-color="#5c8a4a" stop-opacity=".06" />
                </linearGradient>
            </defs>
            <rect width="100%" height="100%" fill="url(#g1)" />
        </svg>
        <div class="header-inner">
            <a class="brand" href="/">
                <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg"><path d="M12 2C12 2 9 6 9 9c0 3 3 5 3 5s3-2 3-5c0-3-3-7-3-7z" fill="#f4efe2"/><path d="M5 20c2-4 6-6 7-6s5 2 7 6" stroke="#5c8a4a" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round"/></svg>
                Diario de <span>Flora</span>
            </a>

            <nav class="site-nav">
                <ul>
                    <li><a asp-area="" asp-controller="Home" asp-action="Index">Inicio</a></li>
                    <li><a asp-area="" asp-controller="Flores" asp-action="Index">Flores</a></li>
                    <li><a asp-area="" asp-controller="Animales" asp-action="Index">Animales</a></li>
                </ul>
            </nav>
        </div>
    </header>

    <main class="site-main">
        <div class="page-header">
            <h1 class="page-title">@ViewBag.Title</h1>
            <p class="page-subtitle">@ViewBag.Subtitle</p>
        </div>

        @RenderBody()
    </main>

    <footer class="site-footer">
        <div class="footer-inner" style="max-width:1100px;margin:0 auto;display:flex;justify-content:space-between;gap:1rem;flex-wrap:wrap;align-items:center;">
            <div>
                <span class="footer-brand">Diario de Flora</span>
                <div style="opacity:.85;margin-top:.4rem;">Pequeño proyecto de catálogo botánico.</div>
            </div>
            <div style="opacity:.75;">&copy; @DateTime.Now.Year</div>
        </div>
    </footer>

    @RenderSection("Scripts", required: false)
</body>
</html>
