@* ============================================================
   _Layout.cshtml
   Tema: selva / diario de campo, con más elementos gráficos
   (vides, hojas y textura de corteza en header y footer).
   ============================================================ *@
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewBag.Title - Diario de Fauna</title>

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,500;9..144,700&family=Space+Mono:wght@400;700&display=swap" rel="stylesheet">

    <style>
        :root{
            /* --- Paleta selvática: dosel, sotobosque, corteza, ficha de campo --- */
            --dosel-900:#0f2417;      /* verde casi negro, sombra del dosel */
            --dosel-700:#1c3a26;      /* verde hoja profunda */
            --sotobosque-500:#3d6b45; /* verde medio, follaje */
            --musgo-300:#7fa06f;      /* verde musgo claro, acentos suaves */
            --hoja-400:#5c8a4a;       /* verde hoja vivo, para decoración */
            --corteza-800:#4a3423;    /* marrón corteza húmeda */
            --corteza-950:#2b1e14;    /* marrón corteza oscura, footer */
            --tierra-100:#e9e2d0;     /* papel de ficha de campo */
            --ambar-500:#b6822c;      /* ámbar tierra, "vulnerable" */
            --brasa-600:#a34426;      /* rojo tierra/brasa, "en peligro" */
            --hueso-050:#f4efe2;

            --font-display:'Fraunces', serif;
            --font-mono:'Space Mono', monospace;
        }

        *{ box-sizing:border-box; }

        html,body{
            margin:0;
            padding:0;
            background:var(--tierra-100);
            color:var(--dosel-900);
            font-family:var(--font-mono);
            line-height:1.5;
        }

        body{
            background-image:
                radial-gradient(circle at 15% 20%, rgba(61,107,69,0.05) 0, transparent 45%),
                radial-gradient(circle at 85% 80%, rgba(74,52,35,0.06) 0, transparent 50%);
        }

        a{ color:inherit; }

        /* ================= HEADER ================= */
        header.site-header{
            background:
                linear-gradient(180deg, var(--dosel-900) 0%, var(--dosel-700) 100%);
            border-bottom:6px solid var(--corteza-800);
            position:relative;
            overflow:hidden;
        }

        header.site-header .leaf-deco{
            position:absolute;
            top:0; left:0; right:0; bottom:0;
            opacity:.14;
            pointer-events:none;
        }

        header.site-header::after{
            content:"";
            display:block;
            height:14px;
            background-image:
                radial-gradient(circle, var(--hoja-400) 2.5px, transparent 3px);
            background-size:22px 14px;
            background-position:0 3px;
            opacity:.55;
        }

        .header-inner{
            max-width:1100px;
            margin:0 auto;
            padding:1.9rem 1.5rem 1.4rem;
            display:flex;
            align-items:baseline;
            justify-content:space-between;
            flex-wrap:wrap;
            gap:.5rem;
            position:relative;
        }

        .brand{
            font-family:var(--font-display);
            font-weight:700;
            font-size:2.15rem;
            color:var(--hueso-050);
            letter-spacing:.5px;
            text-decoration:none;
            display:inline-flex;
            align-items:center;
            gap:.5rem;
        }

        .brand svg{ width:1.6rem; height:1.6rem; flex-shrink:0; }

        .brand span{
            color:var(--musgo-300);
            font-style:italic;
            font-weight:500;
        }

        nav.site-nav ul{
            list-style:none;
            display:flex;
            gap:1.5rem;
            margin:0;
            padding:0;
        }

        nav.site-nav a{
            text-decoration:none;
            color:var(--hueso-050);
            font-size:.85rem;
            border-bottom:2px solid transparent;
            padding-bottom:2px;
            transition:border-color .15s ease;
        }

        nav.site-nav a:hover{
            border-color:var(--ambar-500);
        }

        /* ================= MAIN ================= */
        main.site-main{
            max-width:1100px;
            margin:0 auto;
            padding:2.5rem 1.5rem 4rem;
        }

        .page-title{
            font-family:var(--font-display);
            font-size:2rem;
            font-weight:700;
            color:var(--dosel-700);
            margin:0 0 .35rem;
        }

        .page-subtitle{
            color:var(--corteza-800);
            font-size:.9rem;
            margin:0 0 2rem;
            max-width:60ch;
        }

        /* ---------- Utilidades para el listado de animales ---------- */
        .animal-grid{
            display:grid;
            grid-template-columns:repeat(auto-fill, minmax(230px, 1fr));
            gap:1.25rem;
        }

        .animal-card{
            background:var(--hueso-050);
            border:1px solid rgba(74,52,35,0.15);
            border-left:4px solid var(--sotobosque-500);
            border-radius:2px;
            padding:1.1rem 1.1rem 1.3rem;
            position:relative;
        }

        .animal-card h3{
            font-family:var(--font-display);
            font-size:1.15rem;
            margin:.2rem 0 .1rem;
            color:var(--dosel-900);
        }

        .animal-card .nombre-cientifico{
            font-style:italic;
            font-size:.78rem;
            color:var(--sotobosque-500);
            margin:0 0 .6rem;
        }

        .estado-conservacion{
            display:inline-block;
            font-size:.7rem;
            padding:.2rem .55rem;
            border-radius:2px;
            font-weight:700;
        }

        .estado-conservacion.estable{
            background:rgba(61,107,69,0.15);
            color:var(--sotobosque-500);
        }

        .estado-conservacion.vulnerable{
            background:rgba(182,130,44,0.18);
            color:var(--ambar-500);
        }

        .estado-conservacion.peligro{
            background:rgba(163,68,38,0.18);
            color:var(--brasa-600);
        }

        /* ================= FOOTER ================= */
        footer.site-footer{
            background:var(--corteza-950);
            color:var(--hueso-050);
            padding:2rem 1.5rem 1.5rem;
            font-size:.78rem;
            position:relative;
            overflow:hidden;
        }

        footer.site-footer::before{
            content:"";
            display:block;
            height:12px;
            margin:0 auto 1.4rem;
            max-width:1100px;
            background-image:
                radial-gradient(circle, var(--hoja-400) 2px, transparent 2.5px);
            background-size:20px 12px;
            opacity:.4;
        }

        .footer-inner{
            max-width:1100px;
            margin:0 auto;
            display:flex;
            justify-content:space-between;
            align-items:center;
            flex-wrap:wrap;
            gap:.75rem;
        }

        .footer-brand{
            font-family:var(--font-display);
            font-style:italic;
            font-size:1rem;
            color:var(--musgo-300);
        }

        .footer-meta{
            opacity:.75;
            display:flex;
            gap:1.25rem;
            flex-wrap:wrap;
        }

        @@media (max-width: 640px){
            .header-inner{ flex-direction:column; align-items:flex-start; }
            nav.site-nav ul{ gap:1rem; flex-wrap:wrap; }
            .footer-inner{ flex-direction:column; align-items:flex-start; }
        }
    </style>

    @RenderSection("Styles", required: false)
</head>
<body>

    <header class="site-header">
        @* Decoración de hojas de fondo, en SVG puro *@
        <svg class="leaf-deco" viewBox="0 0 400 120" preserveAspectRatio="none" xmlns="http://www.w3.org/2000/svg">
            <path d="M20 100 Q40 60 80 70 Q60 90 20 100Z" fill="#f4efe2"/>
            <path d="M340 20 Q370 10 380 40 Q355 45 340 20Z" fill="#f4efe2"/>
            <path d="M180 90 Q210 50 250 65 Q225 95 180 90Z" fill="#f4efe2"/>
            <path d="M120 15 Q140 -5 160 10 Q145 30 120 15Z" fill="#f4efe2"/>
        </svg>

        <div class="header-inner">
            <a class="brand" href="/animales">
                <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                    <path d="M12 2C7 2 3 6 3 11c0 5 4 9 9 11 5-2 9-6 9-11 0-5-4-9-9-9Z" stroke="#7fa06f" stroke-width="1.5"/>
                    <path d="M12 6v11M12 9c-2-1-3.5-1-5 0M12 12c2-1 3.5-1 5 0" stroke="#7fa06f" stroke-width="1.3" stroke-linecap="round"/>
                </svg>
                Diario de <span>Fauna</span>
            </a>
            <nav class="site-nav">
                <ul>
                    <li><a href="/animales">Listado</a></li>
                </ul>
            </nav>
        </div>
    </header>

    <main class="site-main">
        @RenderBody()
    </main>

    <footer class="site-footer">
        <div class="footer-inner">
            <span class="footer-brand">Diario de Fauna</span>
            <div class="footer-meta">
                <span>Registros de campo &amp; conservación</span>
                <span>&copy; @DateTime.Now.Year</span>
            </div>
        </div>
    </footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @RenderSection("Scripts", required: false)
</body>
</html>
