@model ClaseMVC.Entidades.Comercio

@{
    ViewData["Title"] = "Crear Comercio";
    var productosDisponibles = ViewBag.ProductosDisponibles as List<string> ?? new List<string>();
}

<audio id="audioAccion" src="~/audio/click.mp3" preload="auto"></audio>

<div class="container my-4" style="max-width: 650px;">
    <div class="card shadow-sm">
        <div class="card-header bg-success text-white">
            <h4 class="card-title mb-0">Agregar Nuevo Comercio</h4>
        </div>
        <div class="card-body">
            <form asp-action="CrearComercio" method="post">
                <!-- Nombre del Comercio -->
                <div class="mb-3">
                    <label asp-for="Nombre" class="form-label fw-bold">Nombre del Comercio</label>
                    <input asp-for="Nombre" class="form-control" placeholder="Ej: Supermercado Central" required />
                </div>

                <!-- Lista de Productos con Checkbox y Precio -->
                <div class="mb-4">
                    <label class="form-label fw-bold">Productos y Precios para este comercio:</label>
                    @if (productosDisponibles.Any())
                    {
                        <div class="border rounded p-3 bg-light" style="max-height: 250px; overflow-y: auto;">
                            @foreach (var prodNombre in productosDisponibles)
                            {
                                <div class="row align-items-center mb-2">
                                    <div class="col-6">
                                        <div class="form-check">
                                            <input class="form-check-input chk-producto"
                                                   type="checkbox"
                                                   name="productosSeleccionados"
                                                   value="@prodNombre"
                                                   id="prod_@prodNombre"
                                                   onchange="togglePrecioInput(this, '@prodNombre')">
                                            <label class="form-check-label" for="prod_@prodNombre">
                                                @prodNombre
                                            </label>
                                        </div>
                                    </div>
                                    <div class="col-6">
                                        <div class="input-group input-group-sm">
                                            <span class="input-group-text">$</span>
                                            <input type="number"
                                                   step="0.01"
                                                   name="precios[@prodNombre]"
                                                   id="precio_@prodNombre"
                                                   class="form-control"
                                                   placeholder="0.00"
                                                   disabled />
                                        </div>
                                    </div>
                                </div>
                            }
                        </div>
                    }
                    else
                    {
                        <p class="text-muted small">No hay productos registrados aún en el sistema.</p>
                    }
                </div>

                <!-- Botones -->
                <div class="d-flex justify-content-between align-items-center">
                    <a asp-action="Index" class="btn btn-outline-secondary" onclick="reproducirSonido()">
                        Cancelar
                    </a>
                    <button type="submit" class="btn btn-success" onclick="reproducirSonido()">
                        Guardar Comercio
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function reproducirSonido() {
            const sonido = document.getElementById('audioAccion');
            if (sonido) {
                sonido.currentTime = 0;
                sonido.play().catch(e => console.log(e));
            }
        }

        // Habilita el campo de precio únicamente si el checkbox del producto está marcado
        function togglePrecioInput(checkbox, prodNombre) {
            const inputPrecio = document.getElementById('precio_' + prodNombre);
            if (inputPrecio) {
                inputPrecio.disabled = !checkbox.checked;
                if (checkbox.checked) {
                    inputPrecio.focus();
                } else {
                    inputPrecio.value = '';
                }
            }
        }
    </script>
}