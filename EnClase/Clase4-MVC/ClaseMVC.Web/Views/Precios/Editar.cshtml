@using System.Globalization
@model Dictionary<string, double>

@{
    ViewData["Title"] = "Editar Precios del Producto";
    string nombreProducto = ViewBag.NombreProducto as string ?? "";
}

<audio id="audioAccion" src="~/img/sounds/flowery-stingus.mp3" preload="auto"></audio>

<div class="container my-4" style="max-width: 600px;">
    <div class="card shadow-sm">
        <div class="card-header bg-warning text-dark">
            <h4 class="card-title mb-0">Editar Precios: <strong>@nombreProducto</strong></h4>
        </div>
        <div class="card-body">
            <form asp-action="Editar" method="post">
                <input type="hidden" name="nombreProducto" value="@nombreProducto" />

                <p class="text-muted small mb-3">
                    Modifica el precio correspondiente para cada uno de los comercios registrados:
                </p>

                <div class="border rounded p-3 bg-light mb-4">
                    @foreach (var item in Model)
                    {
                        var nombreComercio = item.Key;
                        var precioActual = item.Value;

                        <div class="row align-items-center mb-3">
                            <div class="col-6">
                                <label class="form-label fw-bold mb-0">@nombreComercio</label>
                            </div>
                            <div class="col-6">
                                <div class="input-group">
                                    <span class="input-group-text">$</span>
                                    <input type="number"
                                           step="0.01"
                                           name="preciosPorComercio[@nombreComercio]"
                                           value="@precioActual.ToString("0.00", CultureInfo.InvariantCulture)"
                                           class="form-control"
                                           required />
                                </div>
                            </div>
                        </div>
                    }
                </div>

                <div class="d-flex justify-content-between align-items-center">
                    <a asp-action="Index" class="btn btn-outline-secondary" onclick="reproducirSonido()">
                        Cancelar
                    </a>
                    <button type="submit" class="btn btn-warning fw-bold" onclick="reproducirSonido()">
                        Guardar Cambios
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function reproducirSonido() {
            const sonido = document.getElementById('audioAccion');
            if (sonido) {
                sonido.currentTime = 0;
                sonido.play().catch(e => console.log(e));
            }
        }
    </script>
}