@model ClaseMVC.Entidades.Producto

@{
    ViewData["Title"] = "Crear Nuevo Producto";
    var comercios = ViewBag.Comercios as List<ClaseMVC.Entidades.Comercio>;
}

<!-- Elemento de audio -->
<audio id="audioAccion" src="~/img/sounds/ralsei-splat.mp3" preload="auto"></audio>

<div class="container my-4" style="max-width: 600px;">
    <div class="card shadow-sm">
        <div class="card-header bg-primary text-white">
            <h4 class="card-title mb-0">Agregar Nuevo Producto</h4>
        </div>
        <div class="card-body">
            <form asp-action="Crear" method="post">
                <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                <!-- Campo Empresa / Comercio (Selector dinámico) -->
                <div class="mb-3">
                    <label for="nombreComercio" class="form-label fw-bold">Empresa / Comercio</label>
                    <select id="nombreComercio" name="nombreComercio" class="form-select" required>
                        <option value="" selected disabled>-- Selecciona un comercio --</option>
                        @if (comercios != null)
                        {
                            @foreach (var comercio in comercios)
                            {
                                <option value="@comercio.Nombre">@comercio.Nombre</option>
                            }
                        }
                    </select>
                </div>

                <!-- Campo Nombre del Producto -->
                <div class="mb-3">
                    <label asp-for="Nombre" class="form-label fw-bold">Nombre del Producto</label>
                    <input asp-for="Nombre" class="form-control" placeholder="Ej: Leche Entera 1L" required />
                    <span asp-validation-for="Nombre" class="text-danger"></span>
                </div>

                <!-- Campo Precio -->
                <div class="mb-4">
                    <label asp-for="Precio" class="form-label fw-bold">Precio ($)</label>
                    <input asp-for="Precio" type="number" step="0.01" class="form-control" placeholder="0.00" required />
                    <span asp-validation-for="Precio" class="text-danger"></span>
                </div>

                <!-- Botones de Acción -->
                <div class="d-flex justify-content-between align-items-center">
                    <a asp-action="Index" class="btn btn-outline-secondary" onclick="reproducirSonido()">
                        Cancelar
                    </a>
                    <button type="submit" class="btn btn-success" onclick="reproducirSonido()">
                        Guardar Producto
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }

    <script>
        function reproducirSonido() {
            const sonido = document.getElementById('audioAccion');
            if (sonido) {
                sonido.currentTime = 0;
                sonido.play().catch(error => {
                    console.log("Audio bloqueado por el navegador:", error);
                });
            }
        }
    </script>
}